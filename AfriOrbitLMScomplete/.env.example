# =============================================================================
# AfriOrbit LMS — environment
# Copy to .env.local for development. In production set these in Vercel.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project URL and anon key. Both are public by design; the anon key only ever
# grants what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. BYPASSES row-level security entirely.
# Never expose to the browser, never prefix with NEXT_PUBLIC_, and rotate it if
# it is ever pasted anywhere it should not be.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site --------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for email links, certificate
# verification URLs and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=AfriOrbit Space
NEXT_PUBLIC_SUPPORT_EMAIL=learn@afriorbit.space

# --- Security ----------------------------------------------------------------
# Salt for hashing client IPs in the audit log and rate limiter. Generate with:
#   openssl rand -hex 32
# Changing it resets all rate-limit buckets and breaks correlation with older
# audit entries. That is acceptable but do it deliberately.
IP_HASH_SALT=change-me-to-a-long-random-string

# Who must hold a verified TOTP factor.
#   all   — every account (default, recommended)
#   staff — admins and instructors only
MFA_POLICY=all

# How new accounts are activated.
#   approval — land in `pending` until an admin approves (default)
#   open     — activate as soon as email is confirmed
REGISTRATION_MODE=approval

# Origins allowed to iframe /embed/* and call the embed JSON API.
# Comma-separated, scheme included, no trailing slash.
EMBED_ALLOWED_ORIGINS=https://www.afriorbit.space,https://afriorbit.space

# --- Stripe (optional) -------------------------------------------------------
# Leave unset to run with free courses only. The checkout button degrades to a
# 503 rather than breaking the build.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
