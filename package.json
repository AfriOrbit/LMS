{
  "name": "afriorbit-sims",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "check:domain": "tsx scripts/check-domain.ts",
    "check:stale": "tsx scripts/check-stale.ts",
    "check:power": "tsx scripts/check-power.ts",
    "check:orbit": "tsx scripts/check-orbit.ts",
    "check:mission": "tsx scripts/check-mission.ts",
    "check:geometry": "tsx scripts/check-geometry.ts",
    "check:physics": "npm run check:power && npm run check:orbit && npm run check:mission && npm run check:geometry",
    "extract": "python3 scripts/extract-hardware.py && python3 scripts/extract-geometry.py",
    "verify": "npm run typecheck && npm run check:content && npm run check:physics && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "katex": "^0.18.2",
    "lucide-react": "^1.30.0",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "description": "AfriOrbit Space learning platform — CubeSat and satellite-to-IoT engineering training"
}
